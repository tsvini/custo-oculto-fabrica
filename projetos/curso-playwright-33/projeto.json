         [
          "✗",
          "WebKit (Safari)",
          "o botão sumiu",
          "#ff6b6b"
         ]
        ],
        "titulo": "O MESMO SITE"
       }
      },
      {
       "text": "Roda tudo: dezoito testes, que são os seis do projeto vezes três navegadores. E repara na linha workers. Aqui na minha máquina apareceram quatro; na sua pode aparecer outro número. Worker é um trabalhador: um processo que ajuda a rodar testes ao mesmo tempo.",
       "scene": {
        "type": "editor",
        "arquivo": "usuarios.spec.js",
        "pastas": [
         "meu-primeiro-playwright",
         "  .github/",
