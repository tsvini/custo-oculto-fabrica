      {
       "text": "Isso não está em ordem. Antes de escrever uma linha de automação, você acabou de achar um bug.",
       "scene": {
        "type": "bigtext",
        "stagger": 0.25,
        "lines": [
         [
          "ANTES DE UMA LINHA DE CÓDIGO",
          "white",
          90
