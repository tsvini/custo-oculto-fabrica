          "sentences": [
            {
              "text": "Fala, pessoal! Chegamos na última aula. Hoje o seu projeto vai pro GitHub, e vira o seu portfólio.",
              "scene": {
                "type": "bigtext",
                "stagger": 0.25,
                "lines": [
                  [
                    "ÚLTIMA AULA",
                    "gold",
                    170
                  ],
                  [
                    "O SEU PORTFÓLIO",
                    "white",
                    120
                  ]
                ]
              }
            },
            {
              "text": "O GitHub é tipo uma rede social de código. As empresas olham ele pra ver o que você sabe fazer. Então um projeto lá vale muito numa entrevista.",
              "scene": {
                "type": "cards",
                "itens": [
