      {
       "text": "O projeto está pronto. Agora, a pergunta: como guardar ele do jeito certo, de um jeito que dá pra voltar atrás se alguma coisa quebrar?",
       "scene": {
        "type": "bigtext",
        "stagger": 0.25,
        "lines": [
         [
          "O PROJETO ESTÁ PRONTO",
          "white",
          100
