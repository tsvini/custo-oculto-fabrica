       "text": "Então, apaga o nome do teste com as aspas, e escreve no lugar, com crase: login funciona para, cifrão, abre chaves, usuario, fecha chaves.",
       "scene": {
        "type": "editor",
        "arquivo": "usuarios.spec.js",
        "codigo": "for (const usuario of listaDeUsuarios) {\n  test(`login funciona para ${usuario}`, async ({ page }) => {\n    await page.goto('/');\n    await page.getByTestId('username').fill(usuario);\n    await page.getByTestId('password').fill(process.env.SAUCE_PASSWORD);\n    await page.getByTestId('login-button').click();\n    // o performance_glitch_user é lento: 10 segundos em vez de 5\n    await expect(page.getByTestId('title')).toHaveText('Products', { timeout: 10000 });\n  });\n}",
        "legenda": "Crase: texto + valor",
        "fonte": 24,
        "digitar": false,
        "pastas": null,
