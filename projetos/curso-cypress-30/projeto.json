          "sentences": [
            {
              "text": "Fala, pessoal! Mais uma aula extra. No módulo um, eu mostrei a instalação no Windows. Se o seu computador é um Mac, ou um Linux, tipo o Ubuntu, essa aula é pra você.",
              "scene": {
                "type": "bigtext",
                "stagger": 0.25,
