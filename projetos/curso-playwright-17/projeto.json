      },
      {
       "text": "Esse placeholder é o que o get by placeholder usa. E esse data-test é a tal etiqueta de teste.",
       "scene": {
        "type": "traducao",
        "codigo": "placeholder=\"Username\"  data-test=\"username\"",
        "texto_puro": true,
