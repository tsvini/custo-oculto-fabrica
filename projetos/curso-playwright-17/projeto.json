         ]
        ],
        "passo": 2.0
       }
      },
      {
       "text": "get by role: ache pela função. Botão, link, campo, título. É o tipo de seletor que o Playwright recomenda, porque ele parte do que a pessoa usa na tela.",
       "scene": {
        "type": "tela",
        "media": "site_sauce_botao",
        "url": "https://www.saucedemo.com/",
        "titulo": "saucedemo.com",
        "legenda": "getByRole('button'): ache pela função botão",
        "zoom_em": 1.4,
        "caixa_em": 2.0,
        "alvo_css": "#login-button"
       }
      },
      {
       "text": "get by text: ache pelo texto que aparece. get by placeholder: pelo texto cinza de dentro do campo. E get by label: pela etiqueta escrita do lado do campo.",
       "scene": {
        "type": "cards",
        "itens": [
         [
          "Aa",
          "getByText",
          "pelo texto que aparece"
         ],
         [
          "▭",
