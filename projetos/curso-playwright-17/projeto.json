          "#69a7ff"
         ],
         [
          "🏷",
          "getByLabel",
          "pela etiqueta do lado do campo",
          "#ffd23f"
         ]
        ]
       }
      },
      {
       "text": "E get by test id: ache por uma etiqueta que o próprio desenvolvedor deixou no código, só pra teste.",
       "scene": {
        "type": "devtools",
        "media": "site_sauce_dev",
