      {
       "text": "Olha o que aparece: input, placeholder igual Username, e data-test igual username.",
       "scene": {
        "type": "devtools",
        "media": "site_sauce_dev",
        "url": "https://www.saucedemo.com/",
        "inspecionar": "#user-name",
        "aberto": true,
