      {
       "text": "Até agora você achou coisas na tela de três jeitos: pelo texto cinza do campo, pela função e pelo texto. Hoje você vê o mapa completo.",
       "scene": {
        "type": "bigtext",
        "stagger": 0.25,
        "lines": [
         [
          "AULA 17",
          "muted",
          80
