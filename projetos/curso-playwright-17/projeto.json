      },
      {
       "text": "Mas de onde vem tudo isso? Do código da página. Clica com o botão direito no campo Username e escolhe Inspecionar.",
       "scene": {
        "type": "devtools",
        "media": "site_sauce_dev",
        "url": "https://www.saucedemo.com/",
        "inspecionar": "#user-name",
        "legenda": "Botão direito › Inspecionar"
