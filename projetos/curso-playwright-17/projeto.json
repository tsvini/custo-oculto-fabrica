         ]
        ]
       }
      },
      {
       "text": "Todo comando que acha um elemento começa com get by, que quer dizer: ache pelo. O que muda é o que vem depois.",
       "scene": {
        "type": "traducao",
        "codigo": "page.getByRole('button')",
        "partes": [
         [
          "getBy",
          "ache pelo"
         ],
